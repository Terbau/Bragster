// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
  avatarUrl String?
  admin     Boolean  @default(false)

  receipts           Receipt[]
  payments           SmartReceiptPayment[]
  smartReceipts      SmartReceipt[]
  createdInviteLinks SmartReceiptInviteLink[]
  padelGames         PadelGame[]
}

// All below represents a receipt and its items. They are the models for the
// "smart receipt" / "collective receipt" feature. They are just to represent
// the data structure and relationships of receipts. It may be used for more
// features in the future.

model Receipt {
  id           String    @id @default(uuid())
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  merchantName String
  receiptType  String?
  receiptDate  DateTime?
  totalPrice   Float
  currencyCode String?
  // Where the merchant name, date and total are on the scanned image, as
  // rectangles relative to the image size: { merchantName?, date?, total? }
  regions      Json?
  createdBy    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemGroups    ReceiptItemGroup[]
  smartReceipts SmartReceipt[]
  image         ReceiptImage?

  @@index([userId])
}

// The scanned image, kept in its own table so receipt queries don't load it
model ReceiptImage {
  id        String   @id @default(uuid())
  receiptId String   @unique
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model ReceiptItemGroup {
  id           String   @id @default(uuid())
  receiptId    String
  description  String
  price        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // quantity could be a decimal number
  quantity     Float
  quantityUnit String?
  unitPrice    Float
  // Where the scanned lines of this group are on the image, relative to the
  // image size: [{ kind: "item" | "supplement", line, description?, price? }]
  regions      Json?

  receipt      Receipt                       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  items        ReceiptItem[]
  translations ReceiptItemGroupTranslation[]

  @@index([receiptId])
}

model ReceiptItem {
  id          String   @id @default(uuid())
  itemGroupId String
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itemGroup          ReceiptItemGroup           @relation(fields: [itemGroupId], references: [id], onDelete: Cascade)
  supplements        ReceiptItemSupplement[]
  smartPayments      SmartReceiptPayment[]
  guestSmartPayments SmartReceiptGuestPayment[]

  @@index([itemGroupId])
}

model ReceiptItemSupplement {
  id          String   @id @default(uuid())
  itemId      String
  description String
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item         ReceiptItem                        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  translations ReceiptItemSupplementTranslation[]

  @@index([itemId])
}

model ReceiptItemGroupTranslation {
  id          String @id @default(uuid())
  itemGroupId String

  label                  String
  description            String
  language               String
  lightModeLabelHexColor String
  darkModeLabelHexColor  String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  itemGroup ReceiptItemGroup @relation(fields: [itemGroupId], references: [id], onDelete: Cascade)

  @@index([itemGroupId])
}

model ReceiptItemSupplementTranslation {
  id           String @id @default(uuid())
  supplementId String

  label                  String
  description            String
  language               String
  lightModeLabelHexColor String
  darkModeLabelHexColor  String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  supplement ReceiptItemSupplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  @@index([supplementId])
}

// "Collective receipt" / "Smart receipt" is for the feature where multiple users
// can share a receipt and split the payment in a crowd-funded manner.

enum SmartReceiptAllowedPaymentEditor {
  OWNER
  AUTHENTICATED_USERS
  GUESTS
  ANYONE
}

model SmartReceiptGuest {
  id             String   @id @default(uuid())
  smartReceiptId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  smartReceipt SmartReceipt               @relation(fields: [smartReceiptId], references: [id], onDelete: Cascade)
  payments     SmartReceiptGuestPayment[]

  @@unique([smartReceiptId, name])
  @@index([smartReceiptId])
}

model SmartReceipt {
  id                    String                           @id @default(uuid())
  receiptId             String
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  updatedTotalPrice     Float?
  updatedCurrencyCode   String?
  allowedPaymentEditors SmartReceiptAllowedPaymentEditor @default(OWNER)

  receipt       Receipt                    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  users         User[] // The users who are a part of this smart receipt
  guests        SmartReceiptGuest[]
  payments      SmartReceiptPayment[]
  guestPayments SmartReceiptGuestPayment[]
  inviteLinks   SmartReceiptInviteLink[]

  @@index([receiptId])
}

model SmartReceiptPayment {
  id             String   @id @default(uuid())
  userId         String
  smartReceiptId String
  receiptItemId  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  smartReceipt SmartReceipt? @relation(fields: [smartReceiptId], references: [id], onDelete: Cascade)
  item         ReceiptItem   @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)
}

model SmartReceiptGuestPayment {
  id             String   @id @default(uuid())
  guestId        String
  smartReceiptId String
  receiptItemId  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  guest        SmartReceiptGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  smartReceipt SmartReceipt?     @relation(fields: [smartReceiptId], references: [id], onDelete: Cascade)
  item         ReceiptItem       @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)

  @@index([guestId])
}

model SmartReceiptInviteLink {
  id             String    @id @default(uuid())
  smartReceiptId String
  createdById    String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?

  smartReceipt SmartReceipt @relation(fields: [smartReceiptId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([smartReceiptId])
}

// Americano padel: every player partners with every other player once, and the
// points each player's teams win are added up. Players are just names, they
// don't need an account.

model PadelGame {
  id             String      @id @default(uuid())
  userId         String
  name           String
  format         PadelFormat @default(AMERICANO)
  courts         Int
  // Optional names, like "Court 7", in court order
  courtNames     String[]    @default([])
  // The points of both teams in a match add up to this
  pointsPerMatch Int
  // Mexicano rounds are drawn one at a time, until this many are played
  plannedRounds  Int?
  // Anyone with the token can follow the game live, without signing in
  shareToken     String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  createdBy  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  players    PadelPlayer[]
  rounds     PadelRound[]
  recordings PadelRecording[]

  @@index([userId])
}

enum PadelFormat {
  // Everyone partners with everyone once
  AMERICANO
  // An Americano where teams of about the same rating meet
  ELO_AMERICANO
  // Each round is drawn from the leaderboard, so the matches stay even
  MEXICANO
}

model PadelPlayer {
  id          String  @id @default(uuid())
  gameId      String
  name        String
  // The order the players were added in
  position    Int
  // Sits out the extra round when not everyone can sit out equally often
  sitsOutMore Boolean @default(false)

  game PadelGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, name])
  @@index([gameId])
}

model PadelRound {
  id       String @id @default(uuid())
  gameId   String
  // Play order, which the creator can change
  position Int
  // Every series is a complete Americano where everyone partners with
  // everyone. A new series can be added when the previous one is finished.
  series   Int    @default(1)

  game    PadelGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  matches PadelMatch[]

  @@index([gameId])
}

model PadelMatch {
  id         String   @id @default(uuid())
  roundId    String
  court      Int
  // Ids of the two players on each team
  team1      String[]
  team2      String[]
  team1Score Int?
  team2Score Int?
  // Not played, because the round or series was ended early. The players get
  // their average for it instead.
  isSkipped  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  round      PadelRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  recordings PadelRecording[]

  @@index([roundId])
}

enum PadelRecordingStatus {
  // The app is uploading the video
  UPLOADING
  // Waiting to be analysed
  UPLOADED
  ANALYZING
  READY
  FAILED
}

// A video of one court, filmed with the app. Stored in Azure Blob Storage.
model PadelRecording {
  id              String               @id @default(uuid())
  gameId          String
  // The match the video starts with. It can go on with the next matches on
  // the same court, see `matchCount`.
  matchId         String?
  court           Int
  // How many matches the video covers. Guessed from the rallies when null.
  matchCount      Int?
  // The team nearest the camera in each match, as { [matchId]: 1 | 2 }.
  // Guessed from the rallies and the score when missing.
  nearTeams       Json                 @default("{}")
  status          PadelRecordingStatus @default(UPLOADING)
  blobName        String               @unique
  contentType     String
  sizeBytes       BigInt?
  // Seconds
  duration        Float?
  recordedAt      DateTime
  // Why the analysis failed
  error           String?
  analysisVersion Int?
  analyzedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  game    PadelGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  match   PadelMatch?  @relation(fields: [matchId], references: [id], onDelete: SetNull)
  rallies PadelRally[]

  @@index([gameId])
  @@index([matchId])
}

// A point found in a video
model PadelRally {
  id                 String  @id @default(uuid())
  recordingId        String
  // Seconds into the video
  start              Float
  end                Float
  // Probability that the team nearest the camera won, guessed from the video
  nearWinProbability Float
  // Who won, set by a person. Only used while the rally belongs to that match.
  winnerMatchId      String?
  winnerTeam         Int?
  // Set by a person when it wasn't a point, like the warm up
  isIgnored          Boolean @default(false)

  recording PadelRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
}
